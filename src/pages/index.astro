---
import firms from '../data/firms.json';

const automationColor = {
  allowed: '#22c55e',
  partial: '#f59e0b',
  verify: '#f59e0b',
  banned: '#ef4444'
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Futures Prop Firm Tracker  EAlgo & Automation Rules (Updated 2026)</title>
  <meta name="description" content="Independent, live-updated comparison of futures prop firms that allow algorithmic trading. Automation rules, fees, drawdown types, and payout splits  Everified directly from firm policies." />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f1117; color: #e2e8f0; line-height: 1.6; }
    .header { background: #1a1d2e; border-bottom: 1px solid #2d3148; padding: 2rem 1rem; text-align: center; }
    .header h1 { font-size: 1.8rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem; }
    .header p { color: #94a3b8; max-width: 600px; margin: 0 auto; }
    .updated { display: inline-block; margin-top: 0.75rem; background: #1e293b; border: 1px solid #334155; border-radius: 4px; padding: 0.25rem 0.75rem; font-size: 0.8rem; color: #64748b; }
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
    .section-title { font-size: 1.1rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem; }
    .table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid #1e293b; }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead { background: #1a1d2e; }
    thead th { padding: 0.75rem 1rem; text-align: left; color: #64748b; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #1e293b; white-space: nowrap; }
    tbody tr { border-bottom: 1px solid #1a1d2e; transition: background 0.15s; }
    tbody tr:hover { background: #1a1d2e; }
    tbody td { padding: 0.85rem 1rem; vertical-align: top; }
    .firm-name { font-weight: 600; color: #f1f5f9; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; }
    .badge-allowed { background: #14532d; color: #4ade80; }
    .badge-verify { background: #451a03; color: #fb923c; }
    .badge-banned { background: #450a0a; color: #f87171; }
    .platforms { display: flex; gap: 0.3rem; flex-wrap: wrap; }
    .platform-tag { background: #1e293b; color: #94a3b8; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
    .cost { font-weight: 600; color: #f1f5f9; }
    .note { font-size: 0.78rem; color: #64748b; margin-top: 0.3rem; }
    .rules-link { color: #6366f1; text-decoration: none; font-size: 0.78rem; }
    .rules-link:hover { text-decoration: underline; }
    .disclaimer { margin-top: 2rem; padding: 1rem; background: #1a1d2e; border-radius: 8px; border-left: 3px solid #6366f1; font-size: 0.82rem; color: #64748b; }
    .disclaimer strong { color: #94a3b8; }
  </style>
</head>
<body>

<header class="header">
  <h1>Futures Prop Firm Tracker</h1>
  <p>Independent comparison of prop firms that allow algorithmic and automated trading. Rules verified directly from firm policies.</p>
  <span class="updated">Last updated: May 2026  E<a href="#" style="color:#6366f1">subscribe to rule change alerts</a></span>
<nav style="margin-top:0.75rem;text-align:center"><a href="/blog" style="color:#6366f1;text-decoration:none;font-size:0.85rem">Read our algo trading guides &rarr;</a></nav></header>

<main class="container">
  <p class="section-title">Algo-Friendly Futures Firms  EMay 2026</p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Firm</th>
          <th>Automation</th>
          <th>$50K Eval</th>
          <th>$100K Eval</th>
          <th>Drawdown</th>
          <th>Consistency Rule</th>
          <th>Payout Split</th>
          <th>Platforms</th>
          <th>Rules</th>
        </tr>
      </thead>
      <tbody>
        {firms.map(firm => (
          <tr>
            <td>
              <div class="firm-name">{firm.name}</div>
              {firm.notes && <div class="note">{firm.notes}</div>}
            </td>
            <td>
              <span class={`badge badge-${firm.automation}`}>
                {firm.automation === 'allowed' ? 'Allowed' : firm.automation === 'verify' ? 'Verify' : 'Banned'}
              </span>
              <div class="note">{firm.automation_notes}</div>
            </td>
            <td class="cost">${firm.eval_cost_50k}/mo</td>
            <td class="cost">${firm.eval_cost_100k}/mo</td>
            <td>
              <div>{firm.drawdown_type === 'trailing' ? 'Trailing' : 'End-of-Day'}</div>
              <div class="note">${firm.drawdown_amount_50k.toLocaleString()} on 50K</div>
            </td>
            <td>{firm.consistency_rule === 'none' ? <span style="color:#4ade80">None</span> : firm.consistency_rule}</td>
            <td style="font-weight:600;color:#4ade80">{firm.payout_split}%</td>
            <td>
              <div class="platforms">
                {firm.platforms.map(p => <span class="platform-tag">{p}</span>)}
              </div>
            </td>
            <td>
              <a href={firm.rules_url} target="_blank" rel="noopener" class="rules-link">Policy ↁE/a>
              <div class="note">Checked {firm.rules_last_checked}</div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="disclaimer">
    <strong>Important:</strong> Prop firm rules change frequently and without notice. Always verify the current automation policy directly with the firm before purchasing an evaluation. This tracker is updated manually when rule changes are detected  Elast verified May 2026.
  </div>
</main>

</body>
</html>

